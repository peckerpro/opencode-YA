# YA configuration — copy to .env and fill in your values
# .env is git-ignored; never commit real secrets

# Core paths
YA_HOME=~/.ya

# LLM provider
YA_LLM_PROVIDER=minimax
YA_LLM_MODEL=MiniMax-M3
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Document parser
MINERU_API_KEY=

# GitHub sync
GITHUB_TOKEN=

# Volcengine embedding
VOLCENGINE_API_KEY=
VOLCENGINE_EMBEDDING_MODEL=doubao-embedding-vision-251215
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
